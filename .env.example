# Token del bot de Telegram (de @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# API key de Gemini (https://aistudio.google.com/) -- se usa SOLO para
# entender qué palabra pidió el usuario en un mensaje libre, nunca para
# redactar la definición (esa siempre sale de RAE/Wikcionario).
GEMINI_API_KEY=tu-api-key-de-gemini
GEMINI_MODEL=gemini-3.5-flash

# IDs de Telegram autorizados a usar el bot, separados por coma.
# Vacío (default) = registro abierto, cualquiera puede usarlo.
ALLOWED_USER_IDS=

LOG_LEVEL=INFO
LOG_DIR=logs
